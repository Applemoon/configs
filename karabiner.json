{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Hyper+a -> Russian, Hyper+s -> English, Hyper+d -> Toggle Serbian Cyrillic/Latin",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "a",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option", "left_shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "select_input_source": { "language": "^ru$" } }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "s",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option", "left_shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "select_input_source": { "language": "^en$" } }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.Serbian$" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "d",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option", "left_shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.Serbian-Latin$" } }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.Serbian$" }],
                                        "type": "input_source_unless"
                                    }
                                ],
                                "from": {
                                    "key_code": "d",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option", "left_shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.Serbian$" } }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Caps_lock -> hyper",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_command", "left_control", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Change hyper+hjkl to arrow keys",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "h",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option", "left_shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "left_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "j",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option", "left_shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "down_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "k",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option", "left_shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "up_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "l",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option", "left_shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "right_arrow" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": { "is_keyboard": true },
                    "simple_modifications": [
                        {
                            "from": { "key_code": "delete_or_backspace" },
                            "to": [{ "key_code": "vk_none" }]
                        },
                        {
                            "from": { "key_code": "right_command" },
                            "to": [{ "key_code": "delete_or_backspace" }]
                        }
                    ]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}